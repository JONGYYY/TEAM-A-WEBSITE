# Copy to .env.local and fill in. .env*.local is gitignored — never commit real keys.

# OpenAI — powers résumé extraction and the admissions evaluation.
OPENAI_API_KEY=

# Optional model overrides (sensible defaults live in lib/openai.ts)
# OPENAI_EVAL_MODEL=gpt-4o
# OPENAI_EXTRACT_MODEL=gpt-4o-mini
# OPENAI_ESSAY_MODEL=gpt-5

# Tavily — live college essay-prompt sourcing (server-side only). Get a key at tavily.com.
TAVILY_API_KEY=
